<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>io.github.vladsidorovich.vpn-killswitch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/vpn-killswitch/killswitchd</string>
    <string>--config</string>
    <string>/Library/Application Support/VPNKillSwitch/config.json</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/var/log/vpn-killswitch.log</string>
  <key>StandardOutPath</key><string>/var/log/vpn-killswitch.log</string>
</dict>
</plist>
